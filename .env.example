# Frontend Environment Variables (Browser-Safe)
# Set these when deploying the frontend (e.g. Vercel, Netlify, Cloudflare Pages)
VITE_LEAD_API=https://your-project-ref.supabase.co/functions/v1/lead-pipeline
VITE_AUDIT_API=https://your-project-ref.supabase.co/functions/v1/web-audit

# ============================================================
# SUPABASE EDGE SECRETS (Server-side only)
# Set these in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# OR via Supabase CLI: supabase secrets set KEY=VALUE
# NEVER commit real values to Git or put them in frontend code!
# ============================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
OPENROUTER_API_KEY=sk-or-v1_your_openrouter_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
GMAIL_APP_USER=rymthos.dev@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
RESEND_API_KEY=re_your_resend_api_key_here
