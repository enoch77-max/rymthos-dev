# ============================================================
# RYMTHOS DEV — BACKEND SECRETS (server-side only)
# ------------------------------------------------------------
# Copy to `.env` and pass to the Compute service at deploy time:
#   npx @insforge/cli compute deploy ./backend/compute \
#     --name rymthos-lead --port 8080 --env-file .env
#
# NEVER commit `.env`. It is gitignored. NEVER put these values
# in frontend code or VITE_/PUBLIC_-prefixed variables.
# ============================================================

# InsForge (admin key — bypasses RLS, keep strictly server-side)
INSFORGE_URL=https://4humvgph.us-east.insforge.app
INSFORGE_KEY=ik_your_key_here

# DeepSeek V4 Flash via OpenRouter
OPENROUTER_API_KEY=sk-or-v1_your_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Telegram alerts
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Gmail App Password (Google Account → Security → App passwords)
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
